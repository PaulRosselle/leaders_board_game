classDiagram
    direction TB

    %% Game
    class Game {
        +Board : Board
        +RecruitableCards : List~CharacterCard~
        +RecruitedCharacters : List~Character~
        +BanishedCards : List~CharacterCard~
    }

    %% Handlers
    class IActionHandler {
        <<interface>>
        +Game : Game
        +DoAction()
        +UndoAction()
    }
    class TransitionActionHandler
    class RecruitmentActionHandler
    class BanishmentActionHandler
    class CharacterActionHandler

    %% Resolvers
    class CharacterActionResolver {
        <<abstract>>
        +GetNextInteraction(CharacterActionBuilder) InteractionRequest?
        +BuildAction(CharacterActionBuilder) CharacterAction
    }

    %% Builder
    class CharacterActionBuilder {
        +SourceCharacter: Character
        +IsActiveAbility: Boolean
        +InteractionResults: List~InteractionResult~
        +AddResult(InteractionResult)
        +BuildAction() CharacterAction
    }

    %% Queries
    class BoardQuery {
        <<static>>
        +GetCell() Cell
        +FindAdjacentCell() Cell
        +FindLeaderCell() Cell
        +GetCharacterCellById() Cell
        +FindCellsWithMatchingCharacter() List~Cell~
        +FindCellsWithCharacter() List~Cell~
    }

    class GameQuery {
        <<static>>
        +IsLeaderCaptured(TeamColor, Game, GameHistory) Boolean
        +IsLeaderSurrounded(TeamColor, Game) Boolean
        +IsBarrageDetected(TeamColor, Game) Boolean
    }

    class PlayabilityQuery {
        <<static>>
        +CanAct(Game, GameHistory, Character) Boolean
        +MustAct(Game, GameHistory, Character) Boolean
        +CanUseActiveAbility(Game, GameHistory, Character) Boolean
        +GetPlayableCharacters(Game, GameHistory) List~Cell~
    }

    %% Factories
    class BoardFactory {
        <<static>>
        +Create() Board
    }
    class GameFactory {
        <<static>>
        +Create(GameConfig, GameHistory) Game
    }
    class CharacterFactory {
        <<static>>
        +Create() Character
        +Transform(Character, CharacterType, TeamColor) Character
    }
    class GameActionHandlerFactory {
        <<static>>
        +Create(gameAction : IGameAction) IActionHandler
    }
    class CharacterActionResolverFactory {
        <<static>>
        +Create(type : CharacterType) CharacterActionResolver
    }

    %% GameHandler
    class GameHandler {
        +CurrentGame : Game
        +CurrentHistory : GameHistory
    }

    %% Héritage handlers
    IActionHandler <|.. TransitionActionHandler
    IActionHandler <|.. RecruitmentActionHandler
    IActionHandler <|.. BanishmentActionHandler
    IActionHandler <|.. CharacterActionHandler

    %% GameFactory
    GameFactory ..> BoardFactory
    GameFactory ..> CharacterFactory
    GameFactory ..> GameActionHandlerFactory
    GameFactory ..> Game

    %% Resolvers
    CharacterActionResolver ..> CharacterActionBuilder : reads
    CharacterActionResolver ..> BoardQuery
    CharacterActionResolver ..> GameQuery
    CharacterActionResolverFactory ..> CharacterActionResolver

    %% Builder
    GameHandler --> CharacterActionBuilder : creates / writes
    GameHandler --> CharacterActionResolverFactory : calls
    GameHandler --> IActionHandler : creates

    %% Queries
    GameQuery ..> Game
    GameQuery ..> GameHistory
    PlayabilityQuery ..> Game
    PlayabilityQuery ..> GameHistory